<?xml version="1.0" encoding="utf-8"?>
<!-- Quick mixes (4x1): one tap starts a mix in Lyro. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/mix_shuffle"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/widget_tile_background"
        android:contentDescription="Shuffle all songs"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/widget_shuffle" />
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:fontFamily="monospace" android:letterSpacing="0.1"
            android:text="SHUFFLE" android:textColor="@color/widget_fg" android:textSize="10sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mix_favorites"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:background="@drawable/widget_tile_background"
        android:contentDescription="Play favorites"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/widget_heart" />
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:fontFamily="monospace" android:letterSpacing="0.1"
            android:text="FAVORITES" android:textColor="@color/widget_fg" android:textSize="10sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mix_most_played"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:background="@drawable/widget_tile_background"
        android:contentDescription="Play most played"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/widget_spark" />
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:fontFamily="monospace" android:letterSpacing="0.1"
            android:text="TOP PLAYED" android:textColor="@color/widget_fg" android:textSize="10sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
