<?xml version="1.0" encoding="utf-8"?>
<!-- audio_service finds its notification icons by name at runtime, so the release
     resource shrinker sees them as unused. Without them the media notification
     is never built and Android treats background playback as idle. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/audio_service_*,@mipmap/ic_launcher*" />
